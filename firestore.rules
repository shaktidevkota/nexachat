rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function privateProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/private/profile);
    }

    function blockedUsers(userId) {
      return privateProfile(userId).data.blockedUsers == null
        ? []
        : privateProfile(userId).data.blockedUsers;
    }

    function notBlockedBetween(userA, userB) {
      return !(userA in blockedUsers(userB)) && !(userB in blockedUsers(userA));
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in chatMembers(chatId);
    }

    function chatIsUnblocked(chatId) {
      return chatMembers(chatId).size() == 2
        && notBlockedBetween(chatMembers(chatId)[0], chatMembers(chatId)[1]);
    }

    function validTwoPersonChatCreate() {
      return signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && notBlockedBetween(request.resource.data.members[0], request.resource.data.members[1]);
    }

    function searchableProfileIsAllowed() {
      return signedIn()
        && resource.data.uid != request.auth.uid
        && notBlockedBetween(request.auth.uid, resource.data.uid);
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete, list: if false;

      match /public/{documentId} {
        allow get: if isSelf(userId);
        allow list: if false;
        allow create, update, delete: if isSelf(userId);
      }

      match /private/{documentId} {
        allow read, write: if isSelf(userId);
      }

      match /contacts/{contactUid} {
        allow read, write: if isSelf(userId);
      }
    }

    match /userSearchEmails/{emailKey} {
      allow get: if searchableProfileIsAllowed();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /userSearchUsernames/{usernameKey} {
      allow get: if searchableProfileIsAllowed();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get, list: if isChatMember(chatId);
      allow create: if validTwoPersonChatCreate();
      allow update: if isChatMember(chatId) && chatIsUnblocked(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && chatIsUnblocked(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatMember(chatId) && chatIsUnblocked(chatId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
